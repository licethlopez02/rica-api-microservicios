meta {
  name: 1 - Registrar Investigador
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/investigadores
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombreCompleto": "Carlos Mendoza",
    "correoInstitucional": "carlos.mendoza@universidad.edu.co",
    "grupoInvestigacion": "Grupo de Inteligencia Artificial"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    let email = res.body.correoInstitucional || "carlos.mendoza@universidad.edu.co";
    bru.setVar("investigadorEmail", email);
  }
}
